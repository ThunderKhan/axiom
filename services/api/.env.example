# Safe non-secret local defaults (not loaded automatically).
AXIOM_BIND_HOST=127.0.0.1
AXIOM_PORT=8000
AXIOM_CORS_ORIGINS=http://127.0.0.1:3000
AXIOM_DATABASE_REQUIRED=false
# AXIOM_DATABASE_URL=postgresql://<private-runtime-only>
# AXIOM_MIGRATION_DATABASE_URL is migration CLI only; NEVER set on the API or worker.
# A dedicated test-only database is provided by infra/compose.db-test.yml.
AXIOM_WORKER_RUN_SECONDS=30
AXIOM_WORKER_IDLE_SECONDS=0.25

# Optional, non-secret test-project Auth configuration. Set all three together.
# AXIOM_AUTH_ISSUER=https://example-project-ref.supabase.co/auth/v1
# AXIOM_AUTH_AUDIENCE=authenticated
# AXIOM_AUTH_JWKS_URL=https://example-project-ref.supabase.co/auth/v1/.well-known/jwks.json
AXIOM_JWKS_CACHE_MAX_SECONDS=300
