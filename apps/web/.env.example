# Only publicly safe browser configuration belongs in this file.
# Copy to .env.local, then set values from an authorized nonproduction Supabase Auth project.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never use a service_role, sb_secret, database password, or private signing key here.
# The approved project must issue asymmetric user JWTs for FastAPI verification.
